---
import '../styles/global.css';
import {routes,titles} from '../i18n';
const {route=''}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Pellet market intelligence: verified German pellet listings, logistics and editable production economics."/><title>{titles.ru[routes.indexOf(route)]} · Pellet Market Intelligence</title><link rel="icon" href={`${base}/icons/pellet.svg`}/><script is:inline>try{document.documentElement.dataset.theme=JSON.parse(localStorage.getItem('pmi-settings')||'{}').theme||'light'}catch{}</script></head><body><aside class="sidebar"><a class="brand" href={`${base}/`}><span class="brand-icon">▥</span><span>PELLET<span class="brand-small">MARKET INTELLIGENCE</span></span></a><div class="workspace"><span class="online-dot"></span> Germany <span class="muted">/ Research</span></div><nav aria-label="Main navigation">{routes.map((r,i)=><><a class:list={['nav-link',{active:route===r}]} href={`${base}/${r}${r?'/':''}`} data-nav={i}><span class="nav-icon">{['◫','▦','⇄','⌂','⤳','↗','▣','▥','⇢','⌖','◧','≋','◷','◉','⚙','ⓘ'][i]}</span><span data-title={i}>{titles.ru[i]}</span></a>{[3,7,11,13].includes(i)&&<div class="nav-divider"/>}</>)}</nav><div class="sidebar-foot"><span class="online-dot"></span> Static research workspace<br/><small>EUR · Germany · v1.0</small></div></aside><div class="main-wrap"><header class="topbar"><span class="breadcrumb">Workspace <span>/</span> <b data-title={routes.indexOf(route)}>{titles.ru[routes.indexOf(route)]}</b></span><div class="top-actions"><span class="destination">⌖ Berlin · <span id="header-postcode">14163</span></span><select id="language" aria-label="Language"><option value="ru">RU</option><option value="de">DE</option><option value="en">EN</option></select><button id="theme" aria-label="Toggle theme">◐</button></div></header><main><slot/></main><footer>PELLET MARKET INTELLIGENCE <span>Public observations · editable assumptions · no investment advice</span></footer></div><script>import {titles} from '../i18n';const select=document.querySelector<HTMLSelectElement>('#language')!;let settings:{lang:'ru'|'de'|'en';theme:string;postcode:string}={lang:'ru',theme:'light',postcode:'14163'};try{settings={...settings,...JSON.parse(localStorage.getItem('pmi-settings')||'{}')}}catch{}function apply(){document.documentElement.lang=settings.lang;document.documentElement.dataset.theme=settings.theme;select.value=settings.lang;document.querySelectorAll<HTMLElement>('[data-title]').forEach(el=>{el.textContent=titles[settings.lang][Number(el.dataset.title)]});document.querySelector('#header-postcode')!.textContent=settings.postcode;window.dispatchEvent(new CustomEvent('pmi-settings',{detail:settings}));}apply();select.addEventListener('change',()=>{settings.lang=select.value as 'ru'|'de'|'en';localStorage.setItem('pmi-settings',JSON.stringify(settings));apply();});document.querySelector('#theme')!.addEventListener('click',()=>{settings.theme=settings.theme==='dark'?'light':'dark';localStorage.setItem('pmi-settings',JSON.stringify(settings));apply();});window.addEventListener('pmi-save-settings',((e:CustomEvent)=>{settings={...settings,...e.detail};localStorage.setItem('pmi-settings',JSON.stringify(settings));apply();}) as EventListener);</script></body></html>
